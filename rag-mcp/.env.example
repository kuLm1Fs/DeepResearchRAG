# Shared with the Python backend. Same value on both processes.
MCP_INTERNAL_TOKEN=change-me-internal-token

# Python backend the Go server calls.
RAG_BACKEND_URL=http://127.0.0.1:8000

# stdio mode: one local tenant, no bearer token.
MCP_TENANT_ID=local

# http mode: bearer token = tenant. Comma-separated, or a JSON object.
MCP_TOKENS=change-me-bearer-token=local

# Directory the ingest tool may read. Leave empty to disable file_path.
RAG_MCP_INGEST_ROOT=

# Optional.
RAG_MCP_TRANSPORT=stdio
RAG_MCP_ADDR=:8081
RAG_MCP_SEARCH_TIMEOUT=45s
RAG_MCP_INGEST_TIMEOUT=120s
RAG_MCP_DOCUMENT_TIMEOUT=20s
LOG_LEVEL=INFO
